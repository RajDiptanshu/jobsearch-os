# JobSearchOS configuration — copy this file to `.env` (same folder) and fill in.
# The pipeline works without any of these; email digests are then archived to data/outbox only.

# ── Email digests (Gmail) ─────────────────────────────────────────────
# 1. Go to https://myaccount.google.com/apppasswords  (requires 2-Step Verification ON)
# 2. Create an app password, name it "JobSearchOS" — Google shows a 16-character code
# 3. Paste it below WITHOUT spaces
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Where to send the digest (defaults to profile email if empty)
DIGEST_TO=you@gmail.com

# ── Optional: custom SMTP instead of Gmail ────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Optional: Adzuna job API (free tier: https://developer.adzuna.com) ─
# Adds broad India coverage (aggregates many boards) to the hourly scan
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Optional: JSearch on RapidAPI = Google-for-Jobs results as an API ──
# Covers Indeed/Glassdoor/LinkedIn/many portals in one shot. Free tier (~200/mo):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch → subscribe → copy key
RAPIDAPI_KEY=

# ── Optional: Naukri (OFF by default) ─────────────────────────────────
# Naukri is behind Akamai Bot Manager and blocks headless browsers, so this
# is disabled. It only works if you route Playwright through a paid unblocker
# proxy (Bright Data / ScraperAPI). If you set that up, flip this to true.
ENABLE_NAUKRI=false

# ── Auto-apply / recruiter email ──────────────────────────────────────
# For every match at/above this score, the system builds a full application
# package (tailored recruiter email + screening answers + resume attached).
AUTO_APPLY_MIN_SCORE=50

# Path to the resume PDF attached to recruiter emails:
RESUME_PATH=C:\path\to\your\resume.pdf

# HANDS-OFF SENDING (default OFF). When true, the system AUTOMATICALLY emails
# recruiters (where an email is known) for queued matches — no click needed.
# Leave false to review + one-click "Send" from the dashboard Apply Queue.
# Portal-only jobs (no recruiter email) always stay one-click — no bot can
# safely auto-submit LinkedIn/Naukri forms without risking your account.
AUTO_SEND_EMAIL=false
AUTO_SEND_MAX_PER_RUN=5
# Every auto-sent application is BCC'd to you by default (your own address).
# APPLY_CC=
# APPLY_BCC=

# ── Dashboard port ────────────────────────────────────────────────────
PORT=4321
