data/outbox/
data/applications/
data/incoming/
!data/incoming/.gitkeep

# Logs
data/logs/

# Playwright browser binaries (installed via `npm run setup-naukri`)
.playwright-mcp/

# OS/editor cruft
.DS_Store
Thumbs.db
*.log
